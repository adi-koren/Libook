<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="350px"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_marginHorizontal="20sp"
    android:layout_marginVertical="10sp">

    <TextView
        android:id="@+id/clvHeadline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="70"
        android:textSize="20sp"
        android:text="howde cdedan wdedee noecweecwcwt tacewclk about futucere whecen icsct acwl"
        android:textStyle="bold"
        android:textColor="#475D92"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clvUsername"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="17sp"
            android:text="username"
            android:textStyle="bold"
            android:gravity="left"/>

        <TextView
            android:id="@+id/clvDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="15sp"
            android:layout_gravity="end|center_vertical"
            android:text="ijdwowi"
            android:layout_marginRight="30dp"/>
    </FrameLayout>


</LinearLayout>